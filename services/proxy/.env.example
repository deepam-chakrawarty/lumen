# Lumen proxy — copy to .env and fill in. Never commit real secrets.

# HTTP
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# When true, include truncated prompt metadata in logs (still never full prompts by default)
LOG_PROMPTS=false

# Public URL (checkout return links + email verification). No trailing slash.
PUBLIC_BASE_URL=http://localhost:8787

# Admin secret for /admin/* HTTP endpoints and required for production hardening
ADMIN_SECRET=change-me-admin-secret

# Optional pepper mixed into plan-key hashes (rotate carefully — invalidates existing hashes)
KEY_PEPPER=change-me-key-pepper

# Session cookie HMAC for /billing account pages
SESSION_SECRET=change-me-session-secret

# Database: sqlite (default) or postgres
DATABASE_URL=sqlite:./data/lumen.db
# DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen

# Upstream provider API keys (server-side only — never returned to clients)
NVIDIA_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides (defaults come from config/models.yaml)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Upstream timeouts / retries
# UPSTREAM_TIMEOUT_MS applies to waiting for response *headers* only (cleared once the body streams).
UPSTREAM_TIMEOUT_MS=60000
UPSTREAM_CONNECT_TIMEOUT_MS=10000

# Bun.serve idleTimeout in seconds (max 255). Default 0 = disabled so SSE chat
# streams survive long Nemotron/Qwen pauses. Bun's built-in default is 10s.
SERVER_IDLE_TIMEOUT_SECONDS=0

# Paths (relative to services/proxy/)
MODELS_CONFIG=./config/models.yaml
PLANS_CONFIG=./config/plans.yaml

# --- Billing (Phase 3) ---
# Payment provider: razorpay (default) | cashfree | mock
PAYMENT_PROVIDER=razorpay
# Keep true until KYC / go-live. Without Razorpay keys, test mode falls back to mock checkout.
PAYMENT_TEST_MODE=true

# Mailer: console (dev — prints verification links) | smtp
MAILER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lumen <noreply@localhost>

# Razorpay (Subscriptions API https://api.razorpay.com/v1)
# Dashboard → API Keys (test) + Webhooks → Secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (Subscriptions API x-api-version 2026-01-01)
# Sandbox: https://sandbox.cashfree.com/pg  | Production: https://api.cashfree.com/pg
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
